{
  "name": "pallet-pos-playwright",
  "version": "1.0.0",
  "scripts": {
    "test":         "playwright test tests/app.flow.spec.js",
    "test:app":     "playwright test tests/app.flow.spec.js",
    "test:login":   "playwright test tests/app.flow.spec.js --grep TC_LOGIN_001",
    "test:session": "playwright test tests/app.flow.spec.js --grep TC_SESSION",
    "test:cart":    "playwright test tests/app.flow.spec.js --grep TC_CART",
    "test:headed":  "cross-env HEADLESS=false playwright test tests/app.flow.spec.js",
    "test:debug":   "playwright test tests/app.flow.spec.js --debug",
    "report":       "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "cross-env": "^7.0.3"
  }
}
