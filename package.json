{
  "name": "pallet-pos-playwright",
  "version": "1.0.0",
  "scripts": {
    "test":         "playwright test",
    "test:login":   "playwright test tests/login.spec.js",
    "test:session": "playwright test tests/session.spec.js",
    "test:cart":    "playwright test tests/cart.spec.js",
    "test:app":     "playwright test tests/session.spec.js tests/cart.spec.js",
    "test:headed":  "cross-env HEADLESS=false playwright test",
    "test:debug":   "playwright test --debug",
    "report":       "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "cross-env": "^7.0.3"
  }
}