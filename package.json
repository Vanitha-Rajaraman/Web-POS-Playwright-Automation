{
  "name": "web-pos-playwright-automation",
  "version": "1.0.0",
  "description": "Playwright + JavaScript automation framework for Pallet Lynx POS",
  "scripts": {
    "test": "playwright test --project=chromium-grocery --project=chromium-dinein --project=chromium-qsr --project=firefox-grocery --project=firefox-dinein --project=firefox-qsr --project=webkit-grocery --project=webkit-dinein --project=webkit-qsr",
    "test:headed": "npm test -- --headed",
    "test:debug": "npm run test:chromium -- --debug",
    "test:ui": "npm run test:chromium -- --ui",
    "test:chromium": "playwright test --project=chromium-grocery --project=chromium-dinein --project=chromium-qsr",
    "test:firefox": "playwright test --project=firefox-grocery --project=firefox-dinein --project=firefox-qsr",
    "test:webkit": "playwright test --project=webkit-grocery --project=webkit-dinein --project=webkit-qsr",
    "report": "playwright show-report",
    "check": "node scripts/check.js",
    "test:list": "npm test -- --list --reporter=list",
    "test:grocery": "playwright test --project=chromium-grocery --project=firefox-grocery --project=webkit-grocery",
    "test:parallel": "playwright test --project=parallel-tabs",
    "test:restaurant": "playwright test --project=chromium-dinein --project=chromium-qsr --project=firefox-dinein --project=firefox-qsr --project=webkit-dinein --project=webkit-qsr",
    "test:dinein": "playwright test --project=chromium-dinein --project=firefox-dinein --project=webkit-dinein",
    "test:qsr": "playwright test --project=chromium-qsr --project=firefox-qsr --project=webkit-qsr",
    "test:auth": "playwright test --project=auth",
    "test:framework": "playwright test --project=framework --reporter=list"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TwinleavesTech/web-pos-playwrite-automation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/TwinleavesTech/web-pos-playwrite-automation/issues"
  },
  "homepage": "https://github.com/TwinleavesTech/web-pos-playwrite-automation#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.2"
  }
}
